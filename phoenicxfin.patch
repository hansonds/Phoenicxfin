     }
 
     override fun onInterceptBackPressed(): Boolean {
+        if (pointerMode) {
+            setPointerMode(false)
+            return true
+        }
         return connected && webappFunctionChannel.goBack()
     }
 
+    /**
+     * Phoenicxfin: toggles the on-screen pointer (bound to the remote's Menu button).
+     */
+    fun togglePointerMode() {
+        if (!connected) return
+        setPointerMode(!pointerMode)
+    }
+
+    private fun setPointerMode(enabled: Boolean) {
+        val webView = webViewBinding?.webView ?: return
+        pointerMode = enabled
+        webView.evaluateJavascript("window.__phx && window.__phx.setPointer($enabled)", null)
+    }
