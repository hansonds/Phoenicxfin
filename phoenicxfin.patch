@@ -0,0 +1,275 @@
+/*
+ * Phoenicxfin TV helper
+ * - Strong, cinematic focus glow so the remote's selection is always visible (TV layout only)
+ * - "Pointer mode": an on-screen cursor driven by the D-pad, toggled with the remote's Menu (Menu) button.
+ *   OK clicks whatever is under the cursor, Back turns the pointer off.
+ * Additive only: it never changes how your theme looks when nothing is focused.
+ */
+(() => {
+    if (window.__phx) return;
+
+    const VIOLET = '#a99aff';
+
+    // ---------- Focus glow ----------
+    const css = `
+.layout-tv .card:focus .cardScalable,
+.layout-tv .card:focus-within .cardScalable {
+    outline: 3px solid ${VIOLET} !important;
+    outline-offset: 4px !important;
+    box-shadow: 0 0 0 7px rgba(169,154,255,.22), 0 0 34px rgba(147,121,255,.60) !important;
+}
+.layout-tv .card .cardBox { transition: transform .18s cubic-bezier(.22,1,.36,1); }
+.layout-tv .card:focus .cardBox { transform: scale(1.045); }
+.layout-tv .card:focus .cardText-first,
+.layout-tv .card:focus .cardText { color: #fff !important; }
+
+.layout-tv .emby-button:focus,
+.layout-tv .paper-icon-button-light:focus,
+.layout-tv .emby-tab-button:focus,
+.layout-tv .navMenuOption:focus,
+.layout-tv .listItem:focus,
+.layout-tv .actionSheetMenuItem:focus,
+.layout-tv .btnPlay:focus,
+.layout-tv .detailButton:focus,
+.layout-tv .emby-select:focus,
+.layout-tv .emby-input:focus,
+.layout-tv .emby-checkbox-label:focus-within,
+.layout-tv .skip-button:focus,
+.layout-tv a:focus {
+    outline: 2px solid ${VIOLET} !important;
+    outline-offset: 3px !important;
+    box-shadow: 0 0 0 5px rgba(169,154,255,.20), 0 0 22px rgba(147,121,255,.55) !important;
+    border-radius: 12px;
+}
+.layout-tv .emby-tab-button:focus { background: rgba(169,154,255,.18) !important; }
+
+#phx-cursor {
+    position: fixed; left: 0; top: 0; width: 34px; height: 34px;
+    z-index: 2147483647; pointer-events: none; display: none;
+    transform: translate(-4px, -2px);
+    filter: drop-shadow(0 0 6px rgba(147,121,255,.9)) drop-shadow(0 3px 6px rgba(0,0,0,.7));
+    will-change: left, top;
+}
+#phx-cursor.phx-press { transform: translate(-4px, -2px) scale(.82); }
+#phx-toast {
+    position: fixed; left: 50%; bottom: 6vh; transform: translate(-50%, 20px);
+    z-index: 2147483647; pointer-events: none; opacity: 0;
+    padding: .7em 1.4em; border-radius: 999px;
+    background: rgba(17,24,39,.92); color: #f7f7fc;
+    border: 1px solid rgba(169,154,255,.55);
+    box-shadow: 0 0 24px rgba(147,121,255,.45);
+    font: 500 1.05rem/1.3 system-ui, sans-serif; letter-spacing: .02em;
+    transition: opacity .25s, transform .25s;
+}
+#phx-toast.phx-show { opacity: 1; transform: translate(-50%, 0); }
+`;
+    const style = document.createElement('style');
+    style.id = 'phx-tv-style';
+    style.textContent = css;
+    (document.head || document.documentElement).appendChild(style);
+
+    // ---------- Toast ----------
+    let toastEl = null;
+    let toastTimer = 0;
+    function toast(text, ms = 2600) {
+        if (!toastEl) {
+            toastEl = document.createElement('div');
+            toastEl.id = 'phx-toast';
+            document.body.appendChild(toastEl);
+        }
+        toastEl.textContent = text;
+        toastEl.classList.add('phx-show');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(() => toastEl.classList.remove('phx-show'), ms);
+    }
+
+    // ---------- Pointer mode ----------
+    const cursor = document.createElement('div');
+    cursor.id = 'phx-cursor';
+    cursor.innerHTML = '<svg viewBox="0 0 24 24" width="34" height="34"><path d="M4 2.5l15.5 9.2-6.9 1.5 4 7.3-3 1.6-4-7.4-5.6 4.6z" fill="#fff" stroke="' + VIOLET + '" stroke-width="1.6" stroke-linejoin="round"/></svg>';
+
+    let pointerOn = false;
+    let x = window.innerWidth / 2;
+    let y = window.innerHeight / 2;
+    const held = { ArrowUp: 0, ArrowDown: 0, ArrowLeft: 0, ArrowRight: 0 };
+    let looping = false;
+    let lastHover = null;
+
+    function place() {
+        cursor.style.left = x + 'px';
+        cursor.style.top = y + 'px';
+    }
+
+    function elementAtCursor() {
+        return document.elementFromPoint(Math.round(x), Math.round(y));
+    }
+
+    function fire(el, type, Ctor) {
+        const opts = { bubbles: true, cancelable: true, view: window, clientX: x, clientY: y, button: 0 };
+        try {
+            el.dispatchEvent(Ctor === 'pointer' && window.PointerEvent
+                ? new PointerEvent(type, Object.assign({ pointerType: 'mouse', isPrimary: true }, opts))
+                : new MouseEvent(type, opts));
+        } catch (e) { /* ignore */ }
+    }
+
+    function hover() {
+        const el = elementAtCursor();
+        if (el === lastHover) return;
+        if (lastHover) {
+            fire(lastHover, 'pointerout', 'pointer');
+            fire(lastHover, 'mouseout');
+        }
+        lastHover = el;
+        if (el) {
+            fire(el, 'pointerover', 'pointer');
+            fire(el, 'mouseover');
+            fire(el, 'mousemove');
+        }
+    }
+
+    function scrollableParent(el, horizontal) {
+        while (el && el !== document.body && el !== document.documentElement) {
+            const s = getComputedStyle(el);
+            const ov = horizontal ? s.overflowX : s.overflowY;
+            if ((ov === 'auto' || ov === 'scroll')
+                && (horizontal ? el.scrollWidth > el.clientWidth : el.scrollHeight > el.clientHeight)) {
+                return el;
+            }
+            el = el.parentElement;
+        }
+        return null;
+    }
+
+    function edgeScroll(dx, dy) {
+        const el = elementAtCursor();
+        const target = scrollableParent(el, dx !== 0);
+        if (target) {
+            target.scrollBy(dx, dy);
+        } else {
+            window.scrollBy(dx, dy);
+        }
+    }
+
+    function loop() {
+        const now = performance.now();
+        let dx = 0;
+        let dy = 0;
+        for (const k in held) {
+            if (!held[k]) continue;
+            const t = (now - held[k]) / 1000;
+            const speed = Math.min(5 + t * 26, 30); // accelerate while held
+            if (k === 'ArrowUp') dy -= speed;
+            if (k === 'ArrowDown') dy += speed;
+            if (k === 'ArrowLeft') dx -= speed;
+            if (k === 'ArrowRight') dx += speed;
+        }
+        if (dx === 0 && dy === 0) {
+            looping = false;
+            return;
+        }
+        const w = window.innerWidth;
+        const h = window.innerHeight;
+        const nx = Math.max(2, Math.min(w - 4, x + dx));
+        const ny = Math.max(2, Math.min(h - 4, y + dy));
+        // Scroll the page/row when pushing against an edge
+        if (nx !== x + dx || nx <= 24 || nx >= w - 24) edgeScroll(dx * 1.6, 0);
+        if (ny !== y + dy || ny <= 24 || ny >= h - 24) edgeScroll(0, dy * 1.6);
+        x = nx;
+        y = ny;
+        place();
+        hover();
+        requestAnimationFrame(loop);
+    }
+
+    function click() {
+        const el = elementAtCursor();
+        if (!el) return;
+        cursor.classList.add('phx-press');
+        setTimeout(() => cursor.classList.remove('phx-press'), 140);
+        fire(el, 'pointerdown', 'pointer');
+        fire(el, 'mousedown');
+        // Move keyboard focus there too, so the D-pad continues from here after the pointer is turned off
+        const focusTarget = el.closest('button, a, input, select, textarea, [tabindex], .card, .listItem');
+        if (focusTarget && typeof focusTarget.focus === 'function') {
+            try { focusTarget.focus({ preventScroll: true }); } catch (e) { focusTarget.focus(); }
+        }
+        fire(el, 'pointerup', 'pointer');
+        fire(el, 'mouseup');
+        fire(el, 'click');
+    }
+
+    function setPointer(on) {
+        on = !!on;
+        if (on === pointerOn) return pointerOn;
+        pointerOn = on;
+        if (!cursor.isConnected) document.body.appendChild(cursor);
+        if (on) {
+            // Start the pointer on whatever currently has focus
+            const a = document.activeElement;
+            if (a && a !== document.body && a.getBoundingClientRect) {
+                const r = a.getBoundingClientRect();
+                if (r.width && r.height) {
+                    x = r.left + r.width / 2;
+                    y = r.top + r.height / 2;
+                }
+            }
+            place();
+            cursor.style.display = 'block';
+            hover();
+            toast('Pointer ON  \u2022  OK = click  \u2022  Back or \u2630 = off');
+        } else {
+            cursor.style.display = 'none';
+            for (const k in held) held[k] = 0;
+            toast('Pointer OFF', 1400);
+        }
+        return pointerOn;
+    }
+
+    // Capture phase on window runs before Jellyfin's own keyboard navigation
+    window.addEventListener('keydown', (e) => {
+        if (!pointerOn) return;
+        if (e.key in held) {
+            if (!held[e.key]) held[e.key] = performance.now();
+            e.preventDefault();
+            e.stopImmediatePropagation();
+            if (!looping) {
+                looping = true;
+                requestAnimationFrame(loop);
+            }
+        } else if (e.key === 'Enter' || e.keyCode === 13) {
+            e.preventDefault();
+            e.stopImmediatePropagation();
+            if (!e.repeat) click();
+        }
+    }, true);
+
+    window.addEventListener('keyup', (e) => {
+        if (!pointerOn) return;
+        if (e.key in held) {
+            held[e.key] = 0;
+            e.preventDefault();
+            e.stopImmediatePropagation();
+        } else if (e.key === 'Enter' || e.keyCode === 13) {
+            e.preventDefault();
+            e.stopImmediatePropagation();
+        }
+    }, true);
+
+    window.__phx = {
+        setPointer,
+        togglePointer: () => setPointer(!pointerOn),
+        isPointer: () => pointerOn,
+        toast
+    };
+
+    // One-time tip
+    try {
+        if (!localStorage.getItem('phx_tip_shown')) {
+            setTimeout(() => {
+                toast('Tip: press \u2630 Menu on the remote for a pointer', 5000);
+                localStorage.setItem('phx_tip_shown', '1');
+            }, 6000);
+        }
+    } catch (e) { /* ignore */ }
+})();
